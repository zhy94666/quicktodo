<Window x:Class="MyTodo.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyTodo" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        WindowStartupLocation="Manual" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">

    <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Stroke}"
            BorderThickness="1" CornerRadius="10" Margin="8" Padding="14,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.15" Color="#1E3A2F"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;" FontSize="14"
                       Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
            <TextBlock x:Name="ToastText" Margin="8,0,0,0" FontSize="12.5"
                       TextTrimming="CharacterEllipsis" MaxWidth="240"
                       Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
