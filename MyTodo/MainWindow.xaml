<Window x:Class="MyTodo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyTodo"
        Title="MyTodo" Width="340" Height="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True"
        Deactivated="Window_Deactivated"
        PreviewMouseDown="Window_PreviewMouseDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="-1" CornerRadius="12"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 置顶按钮：开=高亮 -->
        <Style x:Key="TopmostButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="On">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

        <Border CornerRadius="12" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.15" Color="#1E3A2F"/>
            </Border.Effect>

        <Grid Margin="10">
            <!-- ========== 主视图 ========== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 头部：模式切换 + 工具按钮（可拖动） -->
                <Grid WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="QuickTab" Content="随手记" GroupName="MainMode"
                                     Style="{StaticResource ModeTab}" Checked="QuickTab_Checked"/>
                        <RadioButton x:Name="DatedTab" Content="按日期" GroupName="MainMode"
                                     Style="{StaticResource ModeTab}" Margin="4,0,0,0" Checked="DatedTab_Checked"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="TopmostBtn" AutomationProperties.AutomationId="TopmostButton" Style="{StaticResource TopmostButton}" Content="&#xE718;"
                                ToolTip="置于顶层" Click="Topmost_Click"/>
                        <Button AutomationProperties.AutomationId="SettingsButton" Style="{StaticResource IconButton}"
                                Content="&#xE713;" ToolTip="设置" Click="OpenSettings_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="隐藏面板" Click="HidePanel_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 任务区（与桌面小组件共用） -->
                <local:TaskListHost x:Name="MainHost" Grid.Row="1"/>
            </Grid>

            <!-- ========== 设置视图 ========== -->
            <Grid x:Name="SettingsView" Background="{StaticResource Brush.Panel}" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                        <Button AutomationProperties.AutomationId="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="返回" Click="BackToMain_Click"/>
                        <TextBlock Text="设置" Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6,10,6,10">

                    <TextBlock Text="呼出快捷键" FontSize="12" Foreground="{StaticResource Brush.Text2}"/>
                    <Border x:Name="HotkeyBox" Background="{StaticResource Brush.Card}" CornerRadius="8"
                            Margin="0,6,0,2" Padding="12,9" Cursor="Hand"
                            Focusable="True" KeyboardNavigation.TabNavigation="Continue"
                            PreviewKeyDown="HotkeyBox_PreviewKeyDown" MouseLeftButtonUp="HotkeyBox_Click">
                        <TextBlock x:Name="HotkeyText" Text="Ctrl + Alt + T" FontSize="13"
                                   Foreground="{StaticResource Brush.Text}"/>
                    </Border>
                    <TextBlock Text="点击后按下新组合键，Esc 取消。支持单键（如 F1、V），单键将全局生效" FontSize="11"
                               TextWrapping="Wrap" Foreground="{StaticResource Brush.Text2}" Margin="2,4,0,0"/>

                    <CheckBox x:Name="CollectEnabledCheck" Style="{StaticResource SettingCheck}" Margin="2,16,0,0"
                              Content="快速收集（剪贴板文字一键进随手记）"
                              Checked="CollectEnabled_Changed" Unchecked="CollectEnabled_Changed"/>
                    <Border x:Name="CollectHotkeyBox" Background="{StaticResource Brush.Card}" CornerRadius="8"
                            Margin="0,8,0,2" Padding="12,9" Cursor="Hand"
                            Focusable="True" KeyboardNavigation.TabNavigation="Continue"
                            PreviewKeyDown="HotkeyBox_PreviewKeyDown" MouseLeftButtonUp="CollectHotkeyBox_Click">
                        <TextBlock x:Name="CollectHotkeyText" Text="Ctrl + Alt + V" FontSize="13"
                                   Foreground="{StaticResource Brush.Text}"/>
                    </Border>
                    <TextBlock Text="在任何应用里复制文字后按此键，直接存入随手记；Esc 取消录制" FontSize="11"
                               TextWrapping="Wrap" Foreground="{StaticResource Brush.Text2}" Margin="2,4,0,0"/>

                    <CheckBox x:Name="AutoHideCheck" Style="{StaticResource SettingCheck}" Margin="2,22,0,0"
                              Content="点击面板外自动隐藏" Checked="AutoHide_Changed" Unchecked="AutoHide_Changed"/>

                    <CheckBox x:Name="StartupCheck" Style="{StaticResource SettingCheck}" Margin="2,14,0,0"
                              Content="开机自动启动" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                    <Grid Margin="2,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="桌面组件不透明度" FontSize="12" Foreground="{StaticResource Brush.Text2}"/>
                            <TextBlock x:Name="OpacityValueText" Grid.Column="1" Text="100%" FontSize="12"
                                       Foreground="{StaticResource Brush.Text2}"/>
                        </Grid>
                        <Slider x:Name="OpacitySlider" Grid.Row="1" Style="{StaticResource SettingSlider}"
                                Minimum="0.25" Maximum="1.0" SmallChange="0.01" LargeChange="0.05"
                                Value="1.0"
                                ValueChanged="OpacitySlider_ValueChanged"
                                Thumb.DragCompleted="OpacitySlider_DragCompleted"/>
                        <TextBlock Grid.Row="2" Text="100% 完全不透明；25% 最透明" FontSize="11"
                                   Foreground="{StaticResource Brush.Text2}" Margin="2,5,0,0"/>
                    </Grid>
                    <TextBlock Text="数据与日志" FontSize="12" Foreground="{StaticResource Brush.Text2}" Margin="2,24,0,0"/>
                    <Border Background="{StaticResource Brush.Card}" CornerRadius="8" Margin="0,6,0,0" Padding="12,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="data.json（待办数据）" FontSize="12.5" Foreground="{StaticResource Brush.Text}"/>
                                <TextBlock x:Name="DataSizeText" Grid.Column="1" Text="—" FontSize="12.5" Foreground="{StaticResource Brush.Text2}"/>
                            </Grid>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="trace.log（运行日志）" FontSize="12.5" Foreground="{StaticResource Brush.Text}"/>
                                <TextBlock x:Name="TraceSizeText" Grid.Column="1" Text="—" FontSize="12.5" Foreground="{StaticResource Brush.Text2}"/>
                            </Grid>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="error.log（错误日志）" FontSize="12.5" Foreground="{StaticResource Brush.Text}"/>
                                <TextBlock x:Name="ErrorSizeText" Grid.Column="1" Text="—" FontSize="12.5" Foreground="{StaticResource Brush.Text2}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button AutomationProperties.AutomationId="CleanHistoryButton" Content="清理历史待办" Style="{StaticResource GhostButton}" Click="CleanHistory_Click"/>
                                <Button AutomationProperties.AutomationId="ClearLogsButton" Content="清空日志" Style="{StaticResource GhostButton}" Click="ClearLogs_Click" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button AutomationProperties.AutomationId="ExportDataButton" Content="导出数据" Style="{StaticResource GhostButton}" Click="ExportData_Click"/>
                                <Button AutomationProperties.AutomationId="ImportDataButton" Content="导入数据" Style="{StaticResource GhostButton}" Click="ImportData_Click" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="导出/导入仅包含待办记录（含回收站），不含设置；导入前自动备份当前数据"
                                       FontSize="10.5" Foreground="{StaticResource Brush.Text2}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="回收站" FontSize="12" Foreground="{StaticResource Brush.Text2}" Margin="2,18,0,0"/>
                    <Border Background="{StaticResource Brush.Card}" CornerRadius="8" Margin="0,6,0,0" Padding="12,10">
                        <StackPanel>
                            <TextBlock x:Name="RecycleInfoText" Text="回收站是空的" FontSize="12.5"
                                       Foreground="{StaticResource Brush.Text}"/>
                            <ScrollViewer x:Name="RecycleListScroll" MaxHeight="150" Margin="0,6,0,0"
                                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <ItemsControl x:Name="RecycleList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource Brush.Text}"/>
                                                    <TextBlock Text="{Binding DeletedTimeText}" FontSize="10.5"
                                                               Foreground="{StaticResource Brush.Text2}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="恢复" VerticalAlignment="Center"
                                                        Style="{StaticResource GhostButton}" FontSize="11"
                                                        Click="RecycleRestore_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel x:Name="RecycleActions" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                                <Button Content="全部恢复" Style="{StaticResource GhostButton}" Click="RecycleRestoreAll_Click"/>
                                <Button Content="清空回收站" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="RecycleClear_Click"/>
                            </StackPanel>
                            <TextBlock Text="回收站内容保留 7 天，应用启动时清理过期项" FontSize="10.5"
                                       Foreground="{StaticResource Brush.Text2}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>

</Window>
