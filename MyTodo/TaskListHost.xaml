<UserControl x:Class="MyTodo.TaskListHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyTodo">

    <UserControl.Resources>

        <!-- 任务条目 -->
        <DataTemplate x:Key="TaskTemplate">
            <Grid MinHeight="36" Margin="6,1" Background="Transparent">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="MinHeight" Value="36"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType={x:Type local:TaskListHost}}}" Value="True">
                                <Setter Property="MinHeight" Value="28"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" Style="{StaticResource CircleCheck}"
                          VerticalAlignment="Center" Click="TaskCheck_Click"/>

                <StackPanel Grid.Column="1" Margin="10,4,4,4" VerticalAlignment="Center">
                    <!-- 显示态（超长自动换行，本体与小组件一致） -->
                    <TextBlock Text="{Binding Title}" FontSize="13"
                               ToolTip="{Binding Title}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                                <Setter Property="TextWrapping" Value="WrapWithOverflow"/>
                                <Setter Property="TextTrimming" Value="None"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text2}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType={x:Type local:TaskListHost}}}" Value="True">
                                        <Setter Property="FontSize" Value="12"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <TextBlock.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=local:TaskListHost}}" CommandParameter="{Binding}"/>
                        </TextBlock.InputBindings>
                    </TextBlock>

                    <!-- 编辑态（二次编辑） -->
                    <TextBox x:Name="EditBox" Margin="-2,0,0,0" FontSize="13"
                             TextWrapping="WrapWithOverflow" AcceptsReturn="False"
                             VerticalScrollBarVisibility="Auto" VerticalAlignment="Center"
                             Background="Transparent" BorderThickness="0,0,0,1"
                             BorderBrush="{StaticResource Brush.Accent}" Foreground="{StaticResource Brush.Text}"
                             CaretBrush="{StaticResource Brush.Text}" Padding="2,0"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="EditBox_KeyDown" LostFocus="EditBox_LostFocus" Loaded="EditBox_Loaded">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType={x:Type local:TaskListHost}}}" Value="True">
                                        <Setter Property="FontSize" Value="12"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- 完成时间 -->
                    <TextBlock x:Name="DoneTime" Text="{Binding CompletedTimeText}" FontSize="10.5"
                               Foreground="{StaticResource Brush.Green}" Margin="0,2,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- 删除（悬停显示） -->
                <Button Grid.Column="2" Content="&#xE711;" FontSize="10"
                        ToolTip="删除" Click="DeleteTask_Click" VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter TargetName="DoneTime" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 日期导航（仅按日期模式） -->
        <Grid x:Name="DateNav" Margin="0,6,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="前一天" Click="DayPrev_Click"/>
                <Button x:Name="DayLabel" Content="今天" Style="{StaticResource GhostButton}"
                        MinWidth="96" FontSize="13" Foreground="{StaticResource Brush.Text}"
                        ToolTip="回到今天" Click="DayLabel_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="后一天" Click="DayNext_Click"/>
            </StackPanel>
            <Button x:Name="PickDayBtn" Style="{StaticResource IconButton}" Content="&#xE787;"
                    HorizontalAlignment="Right" ToolTip="选择日期" Click="PickDay_Click"/>
        </Grid>

        <!-- 添加 -->
        <Grid Grid.Row="1" Margin="0,6,0,8">
            <TextBox x:Name="AddBox" Style="{StaticResource ModernTextBox}"
                     TextChanged="AddBox_TextChanged" KeyDown="AddBox_KeyDown"/>
            <TextBlock x:Name="AddHint"
                       IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Brush.Text2}" FontSize="13">
                <Run FontFamily="{StaticResource IconFont}" Text="&#xE710;"/>
                <Run Text="  添加任务…"/>
            </TextBlock>
        </Grid>

        <!-- 任务列表 -->
        <Grid Grid.Row="2">
            <ListBox x:Name="TasksListBox" AllowDrop="True" Style="{StaticResource TasksListBox}"
                     ItemContainerStyle="{StaticResource TasksListBoxItem}"
                     ItemTemplate="{StaticResource TaskTemplate}"
                     ItemsSource="{Binding VisibleTasks, RelativeSource={RelativeSource AncestorType=local:TaskListHost}}"
                     PreviewMouseLeftButtonDown="TasksListBox_MouseDown"
                     MouseMove="TasksListBox_MouseMove"
                     Drop="TasksListBox_Drop"
                     DragOver="TasksListBox_DragOver"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"/>
            <TextBlock x:Name="EmptyState" Text="暂无任务，添加第一个吧" FontSize="12.5"
                       Foreground="{StaticResource Brush.Text2}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>

        <!-- 底部 -->
        <Grid Grid.Row="3" Margin="2,4,2,0">
            <TextBlock x:Name="CountBadge" Text="" FontSize="11"
                       Foreground="{StaticResource Brush.Text2}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CompleteAllBtn" AutomationProperties.AutomationId="CompleteAllButton" Content="一键完成" Style="{StaticResource GhostButton}"
                       Foreground="{StaticResource Brush.Accent}" Click="CompleteAll_Click" ToolTip="完成当前全部未完成任务"/>
                <Button x:Name="ClearCompletedBtn" Content="清除已完成" Style="{StaticResource GhostButton}"
                        Click="ClearCompleted_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- 日期选择弹层 -->
        <Popup x:Name="DayCalendarPopup" PlacementTarget="{Binding ElementName=PickDayBtn}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Stroke}"
                    BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,4,8,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.12" Color="#1E3A2F"/>
                </Border.Effect>
                <Calendar x:Name="DayCalendar" SelectedDatesChanged="DayCalendar_SelectedDatesChanged"
                          Background="Transparent" BorderThickness="0"/>
            </Border>
        </Popup>
    </Grid>

</UserControl>
